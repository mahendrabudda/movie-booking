# ==========================================================
# Movie Ticket Booking with AI Dynamic Pricing - .env.example
# Copy this file to .env and adjust values for local dev.
# Never commit real production secrets to version control.
# ==========================================================

# Database (PostgreSQL)
POSTGRES_DB=moviebooking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/moviebooking
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT & Ticket QR Security (Use minimum 32-character secrets)
JWT_SECRET=dev-only-jwt-secret-key-change-in-prod-9876543210abcdef
JWT_EXPIRATION_MS=3600000
TICKET_QR_SECRET=dev-only-qr-hmac-secret-key-change-in-prod-1234567890

# Email / SMTP (Use Mailtrap for local dev or Gmail App Password)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_FROM=no-reply@moviebooking.local

# AI Dynamic Pricing ML Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# Payment Gateway (MOCK or RAZORPAY)
PAYMENT_GATEWAY_PROVIDER=MOCK
MOCK_PAYMENT_SECRET=dev-mock-payment-hmac-secret-key
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# Booking & Pricing Rules
HOLD_EXPIRY_MINUTES=5
CANCELLATION_CUTOFF_HOURS=2
CONVENIENCE_FEE_PERCENT=5.0
GST_PERCENT=18.0
